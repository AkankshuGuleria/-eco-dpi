# ================================================================
# ECO-DPI ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env for local development. For production, add the same
# key names in your hosting provider's dashboard. Never commit real values.
# ================================================================

# 1. MongoDB connection string (required)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/eco-dpi?retryWrites=true&w=majority

# 2. JWT signing secret (required, at least 32 random characters)
JWT_SECRET=

# 3. Allow-listed administrator Google accounts (optional, comma-separated)
# The role is granted only after Google verifies the account email. Password
# registrations always remain citizens; provision password admins in the DB.
ADMIN_EMAILS=

# 4. Allowed browser origins (required in production)
CORS_ORIGINS=https://eco-dpi.vercel.app,http://localhost:5173,http://localhost:4173

# 5. Local API port (optional)
PORT=4000

# 6. Frontend API base URL (Vite)
VITE_API_BASE_URL=/api

# 7. Google sign-in (optional)
# Client ID is public and is bundled into the frontend at build time.
# Add http://localhost:5173 and the deployed HTTPS origin to the OAuth client's
# Authorized JavaScript origins in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
# Set this to the same OAuth web client ID; the API checks the ID-token audience.
GOOGLE_CLIENT_ID=

# 8. Twilio SMS codes (optional; console fallback is used in development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
